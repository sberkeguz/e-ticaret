# Kopyala: .env olarak kaydet ve degerleri degistir
POSTGRES_PASSWORD=degistir
JWT_SECRET=en-az-64-karakterlik-rastgele-hex-deger
# Backend ile IyzicoService arasindaki ortak sifre (rastgele uzun bir deger)
INTERNAL_API_TOKEN=en-az-32-karakterlik-rastgele-deger
# RabbitMQ (yerelde varsayilanlar yeterli)
RABBITMQ_USER=eticaret
RABBITMQ_PASSWORD=degistir
IYZIPAY_API_KEY=
IYZIPAY_SECRET_KEY=
IYZIPAY_BASE_URL=https://sandbox-api.iyzipay.com
# 3D Secure donusu: herkese acik HTTPS adres (ornegin ngrok). Backend bu istegi IyzicoService'e iletir.
IYZIPAY_CALLBACK_URL=https://your-public-host/api/payments/callback
APP_FRONTEND_URL=http://localhost:3000
