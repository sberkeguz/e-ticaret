    {
      "id": 9,
      "type": "timeseries",
      "title": "Ödeme olayları (RabbitMQ, dakikada)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rabbitmq_consumed_total{job=\"e-ticaret\"}[$__rate_interval])) * 60",
          "legendFormat": "backend'in işlediği",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rabbitmq_rejected_total{job=\"e-ticaret\"}[$__rate_interval])) * 60",
          "legendFormat": "reddedilen (tekrar/DLQ)",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "table",
      "title": "Son ödeme izleri (tıkla → uçtan uca akış)",
      "description": "Her satır bir ödeme isteği. Açınca backend → iyzico-service → iyzico → RabbitMQ → backend zinciri ve her adımın süresi görünür.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "limit": 20,
          "tableType": "traces",
          "query": "{ resource.service.name = \"e-ticaret\" && name =~ \"http post /api/payments.*\" }"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
