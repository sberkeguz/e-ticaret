        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_milliseconds_count{job=\"e-ticaret\", outcome=\"SERVER_ERROR\"}[15m])) / clamp_min(sum(rate(http_server_requests_milliseconds_count{job=\"e-ticaret\"}[15m])), 1e-9) or vector(0)",
