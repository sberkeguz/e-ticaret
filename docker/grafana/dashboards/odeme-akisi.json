    {
      "id": 5,
      "type": "timeseries",
      "title": "Ödeme isteği süresi (backend)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_milliseconds_bucket{job=\"e-ticaret\", uri=\"/api/payments/checkout\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_milliseconds_bucket{job=\"e-ticaret\", uri=\"/api/payments/checkout\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "iyzico API çağrı süresi",
      "description": "p50/p95 yalnızca cevap alınan çağrılardan hesaplanır. Düşen bağlantı çizgisi adet gösterir.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_client_request_duration_seconds_bucket{job=\"iyzico-service\", server_address=\"sandbox-api.iyzipay.com\", error_type=\"\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_client_request_duration_seconds_bucket{job=\"iyzico-service\", server_address=\"sandbox-api.iyzipay.com\", error_type=\"\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(http_client_request_duration_seconds_count{job=\"iyzico-service\", server_address=\"sandbox-api.iyzipay.com\", error_type!=\"\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "düşen bağlantı (adet)",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Backend istekleri (dakikada, adrese göre)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (method, uri) (rate(http_server_requests_milliseconds_count{job=\"e-ticaret\", uri!~\"/actuator.*\"}[$__rate_interval])) * 60",
          "legendFormat": "{{method}} {{uri}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "iyzico-service istek süresi p95 (adrese göre)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, http_request_method, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"iyzico-service\"}[$__rate_interval])))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
