{
  "name": "iyzico-service",
  "version": "0.1.0",
  "private": true,
  "description": "iyzico ile konuşan tek servis: ödeme denemeleri, durum makinesi, Idempotency-Key",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "start:prod": "prisma migrate deploy && node --import ./dist/instrumentation.js dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/swagger": "^12.1.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-amqplib": "^0.72.0",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "amqplib": "^2.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.4.2",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/rabbitmq": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "@swc/core@1.16.22": true
  }
}
